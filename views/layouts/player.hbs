<!DOCTYPE html>
<html>
    <head>
        <title>Minimal Signage Player</title>
        <style>
html,
body {
    background-color: #000;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

#stage {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
}

#stage iframe,
#stage img,
#stage video {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    margin: 0;
    padding: 0;
    object-fit: contain;
}
        </style>
    </head>
    <body>
        <main id="stage">
            {{#each playlist.items }}
                <article class="slide" data-duration="{{ duration }}">
                    {{#if isImage }}
                        <img src="{{url}}">
                    {{/if }}

                    {{#if isVideo }}
                        <video src="{{ url }}" muted playsinline></video>
                    {{/if }}

                    {{#if isURL }}
                        <iframe src="{{ url }}"></iframe>
                    {{/if }}
                </article>
            {{/each }}
        </main>
        <script src="/scripts/player.js"></script>
    </body>
</html>