{{> header title="Dashboard"}}

<p>Welcome to Minimal Signage!</p>

<div x-data="{count:0}">
    <button @click="count++">
        Clicked <span x-text="count"></span> times
    </button>
</div>
<div>
    <h2>Currently playing</h2>
    <ul>
        <li>{{ playlist.current.src }} &dash; {{ playlist.current.type }}</li>
    </ul>
    <h2>Next:</h2>
    <ul>
        <li>{{ playlist.next.src }} &dash; {{ playlist.next.type }}</li>
    </ul>
</div>