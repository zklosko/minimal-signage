{
  "name": "minimal-signage",
  "version": "1.0.0",
  "description": "A digital signage platform built on Webkit for the humble Raspberry Pi Zero 2W.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "tsx watch server.ts",
    "schema-update": "npx drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@libsql/client": "^0.18.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.12.3",
    "handlebars": "^4.7.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
